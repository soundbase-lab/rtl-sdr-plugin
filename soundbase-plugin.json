{
  "manifestVersion": 1,
  "id": "rtl-sdr",
  "name": "RTL-SDR",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "platforms": ["darwin-arm64"],
  "repository": "https://github.com/soundbase-lab/rtl-sdr-plugin",
  "maintainers": [{ "name": "matt dale" }],
  "contract": {
    "core": "1.4",
    "modules": {
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": { "type": "node", "entrypoint": "main.js" },
  "deployment": ["managed"],
  "template": { "name": "soundbase-plugin-template", "version": "1.0.11" },
  "products": [
    {
      "deviceTypeId": "plugin:rtl-sdr/rtl2832u",
      "manufacturer": { "id": "rtl-sdr", "name": "RTL-SDR" },
      "model": {
        "id": "rtl2832u",
        "name": "RTL2832U",
        "displayName": "RTL-SDR (RTL2832U)"
      },
      "family": { "id": "rtl-sdr", "name": "RTL-SDR" },
      "capabilities": { "spectrumAnalyzer": true },
      "traits": { "isSpectrumAnalyzer": true }
    }
  ],
  "pluginConfigFields": [
    {
      "id": "rtlSdrBinDir",
      "type": "textinput",
      "label": "RTL-SDR tools folder",
      "help": "Folder containing rtl_tcp and rtl_test. Leave empty to search PATH and the usual Homebrew locations."
    }
  ],
  "deviceConfigFields": [
    {
      "id": "serial",
      "type": "textinput",
      "label": "Dongle serial number",
      "help": "The serial rtl_test prints for the dongle, e.g. 00000001. Leave empty to use the first dongle found."
    }
  ],
  "stateKeys": []
}
